PODIUM_ENV=dev

PODIUM_HTTP_ADDR=:8080
PODIUM_HTTP_READ_TIMEOUT=10s
PODIUM_HTTP_WRITE_TIMEOUT=20s
PODIUM_HTTP_IDLE_TIMEOUT=120s
PODIUM_HTTP_SHUTDOWN_TIMEOUT=15s

PODIUM_DATABASE_URL=postgres://podium:podium@localhost:5432/podium?sslmode=disable
PODIUM_POSTGRES_MAX_CONNS=10
PODIUM_POSTGRES_MIN_CONNS=2
PODIUM_POSTGRES_MAX_CONN_LIFETIME=1h
PODIUM_POSTGRES_MAX_CONN_IDLE_TIME=30m

PODIUM_REDIS_URL=redis://localhost:6379/0
PODIUM_REDIS_POOL_SIZE=10

PODIUM_LOG_LEVEL=info
PODIUM_LOG_FORMAT=json

PODIUM_JWT_SECRET=podium-insecure-development-signing-key
PODIUM_JWT_ISSUER=podium
PODIUM_ACCESS_TOKEN_TTL=15m
PODIUM_REFRESH_TOKEN_TTL=720h

PODIUM_ARGON2_MEMORY_KIB=65536
PODIUM_ARGON2_ITERATIONS=2
PODIUM_ARGON2_PARALLELISM=2

PODIUM_LOGIN_MAX_PER_IP=20
PODIUM_LOGIN_MAX_PER_ACCOUNT=8
PODIUM_LOGIN_WINDOW=15m
PODIUM_TRUST_PROXY_IP=false
